<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>F_STOP1</RootNamespace>
    <StartupObject>Sub Main</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
	  <UseWPF>true</UseWPF> <MyType>WindowsForms</MyType>
    <Platforms>AnyCPU;x64</Platforms>
    <ImportedNamespaces>System.Data=False,System.Drawing=False,System.Windows.Forms=False,Microsoft.VisualBasic=True,System=True,System.Collections=True,System.Collections.Generic=True,System.Diagnostics=True,System.Linq=True,System.Xml.Linq=True,System.Threading.Tasks=True,F-STOP1=True</ImportedNamespaces>
    <PackageId>F-STOP1</PackageId>
    <Title>F-Stop</Title>
    <Version>1.0</Version>
    <Authors>Remus Adrian</Authors>
    <Company>Remus Adrian</Company>
    <Product>F-STOP V1.0</Product>
    <Description>F-Stop your Light Room replacement friend</Description>
    <Copyright>F-STOP V1.0 by PRA@2006</Copyright>
    <PackageIcon>F_Stop.png</PackageIcon>
    <ApplicationIcon>F_Stop.ico</ApplicationIcon>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MetadataExtractor" Version="2.9.0" />
    <PackageReference Include="OpenTK" Version="4.9.4" />
    <PackageReference Include="OpenTK.GLControl" Version="4.0.2" />
  </ItemGroup>

<ItemGroup>
  <Compile Update="F_Stop.vb" />
  <Compile Update="F_Stop.Designer.vb">
    <DependentUpon>F_Stop.vb</DependentUpon>
  </Compile>
</ItemGroup>

  <ItemGroup>
    <None Update="My Project\Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.vb</LastGenOutput>
    </None>
    <None Update="Shaders\correction.frag">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Shaders\passthrough.vert">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

	<ItemGroup>
		<Content Include="Shaders\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
	  <Content Include="F_Stop.ico" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="..\..\F_Stop.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="My Project\Resources.resx">
      <CustomToolNamespace>My.Resources</CustomToolNamespace>
      <Generator>VbMyResourcesResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.vb</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>